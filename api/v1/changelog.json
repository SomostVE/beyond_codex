            "bannerImageHash": "9dd16d5a92bf4785ba25da2b5b4a00d4"
          },
          "after": {
            "text": "Fanfare: Give this follower Ambush until the end of your opponent's turn.\n\nAt the end of your turn, restore 1 defense to your leader.",
            "rawSkillText": "<b><color=Keyword>Fanfare</color></b>: Give this follower <b><color=Keyword>Ambush</color></b> until the end of your opponent's turn.\n<hr>At the end of your turn, restore 1 defense to your leader.",
